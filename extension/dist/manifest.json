{
  "manifest_version": 3,
  "name": "SafeLens Dev",
  "version": "0.3.1",
  "description": "Local visual safety filter for browser images. Development build.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "worker/model_worker.js"
  },
  "action": {
    "default_title": "SafeLens",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
