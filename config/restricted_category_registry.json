      "model_branch": "gambling_detector_future",
      "thresholds": {
        "hit_confidence": 0.45,
        "cleanup_confidence": 0.6
      },
      "description": "Gambling-related objects. Planned branch."
    },
    "drug_paraphernalia": {
      "enabled": false,
      "labels": [
        "syringe",
        "pill_bottle",
        "drug_paraphernalia"
