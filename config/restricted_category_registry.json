      "risk_level": "medium_or_high",
      "default_action": "localized_cleanup_or_concealment",
      "requires_bbox": true,
      "cleanup_allowed": false,
      "replacement_mode": "policy_dependent",
      "model_branch": "drug_paraphernalia_detector_future",
      "thresholds": {
        "hit_confidence": 0.45,
        "cleanup_confidence": 0.65
      },
      "description": "Drug-related objects require stricter policy review before cleanup."
    },
    "weapon_like": {
      "enabled": false,
      "labels": [
        "knife",
        "handgun",
        "rifle",
        "weapon_like_object"
      ],
      "risk_level": "medium_or_high",
      "default_action": "localized_blur_or_concealment",
      "requires_bbox": true,
      "cleanup_allowed": false,
      "replacement_mode": "policy_dependent",
      "model_branch": "weapon_like_detector_future",
      "thresholds": {
        "hit_confidence": 0.5,
        "cleanup_confidence": 0.7
